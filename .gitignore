# dependencies
node_modules/

# build output
web/dist/
web/.vite/

# generated PWA
web/dev-dist/
web/public/icons/generated/

# mirrored WASM runtime (regenerated by `pnpm mirror-wasm` / postinstall)
web/public/wasm/

# typescript
*.tsbuildinfo

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# rust
target/

# personal-server local dev state (SQLite index + WAL; TALETREK_DATA_DIR=./data default)
# Root-anchored: a bare `data/` also swallowed android/.../taletrek/data (the app's
# package) — T4/T5's data-layer files silently never landed in the repo.
/data/

# generated bundle dev artifacts (canonical fixtures are committed under crates/synth/tests/fixtures)
*.taletrek
*.taletrek-lib
!crates/synth/tests/fixtures/
!crates/synth/tests/fixtures/*.taletrek
!crates/synth/tests/fixtures/*.taletrek-lib
!crates/parse/testdata/plain.taletrek

# iOS kernel/vendor artifacts (populated by `just ios-kernel`, per machine —
# the jniLibs analogue) + Xcode local state
ios/TaleTrek/Vendor/
ios/TaleTrek.xcodeproj/xcuserdata/
*.xcuserdatad/
ios/DerivedData/
